# Optional: extends qwen3.6:35b's context window to 131072 tokens (128k).
# Not required to run AutoSAM -- the base qwen3.6:35b model works fine as-is.
# Build with:
#   ollama pull qwen3.6:35b
#   ollama create qwen3.6:35b-128k -f Modelfile.qwen3.6-35b-128k

FROM qwen3.6:35b

PARAMETER num_ctx 131072
PARAMETER presence_penalty 1.5
PARAMETER repeat_penalty 1
PARAMETER temperature 1
PARAMETER top_k 20
PARAMETER top_p 0.95
PARAMETER min_p 0
